# ==============================================================================
# SahiRate Backend Environment Configuration Example
# Copy this file to .env for local development or set these in GCP Cloud Console.
# DO NOT commit actual .env files containing production secrets to git.
# ==============================================================================

# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Application project name
PROJECT_NAME="SahiRate Backend API"

# Security: JWT Secret Key (Generate with: openssl rand -hex 32)
# Required in production! Do NOT leave default.
SECRET_KEY=generate_a_random_32_byte_hex_key_here

# Token validity in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection:
# For SQLite (default local): sqlite:///./data/sahirate.db
# For PostgreSQL (Cloud SQL, Supabase, Neon):
# DATABASE_URL=postgresql://sahirate_user:your_password@your-cloud-sql-ip:5432/sahirate_prod
DATABASE_URL=sqlite:///./data/sahirate.db

# CORS Allowed Origins:
# In GCP Cloud Run, list your deployed Vercel frontends (comma-separated):
CORS_ORIGINS=https://your-frontend-collector.vercel.app,https://your-frontend-ra.vercel.app,http://localhost:5173,http://localhost:5174

# Port (Cloud Run automatically sets PORT=8080, optional locally)
PORT=8080
