# ==============================================================================
# SahiRate Collector App (Frontend) Environment Configuration
# Copy this file to .env.local for local testing or configure in Vercel Dashboard.
# ==============================================================================

# Backend API URL (Your deployed GCP Cloud Run URL)
# Example: https://sahirate-backend-xxxx-uc.a.run.app
# Leave blank or omit in local dev if using Vite's /api proxy
VITE_API_URL=https://your-gcp-backend-service-url.a.run.app

# Recycler & Admin Portal URL (Your deployed frontendRA Vercel URL)
# Example: https://sahirate-portal.vercel.app
# In local dev defaults to: http://localhost:5174
VITE_PORTAL_URL=https://your-frontend-ra.vercel.app
